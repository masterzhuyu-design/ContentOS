{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "contentos/content-kernel.schema.json",
  "title": "Content Kernel",
  "type": "object",
  "required": ["schema", "reader_problem", "main_judgment", "reasoning_spine", "conclusion_boundary", "user_locks"],
  "properties": {
    "schema": {"const": "contentos-content-kernel-v1"},
    "reader_problem": {"type": "string", "minLength": 1},
    "main_judgment": {"type": "string", "minLength": 1},
    "reasoning_spine": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "evidence_jobs": {"type": "array", "items": {"type": "object"}},
    "case_jobs": {"type": "array", "items": {"type": "object"}},
    "model_jobs": {"type": "array", "items": {"type": "object"}},
    "conclusion_boundary": {"type": "array", "items": {"type": "string"}},
    "user_locks": {"type": "array", "items": {"type": "string"}},
    "source_pointers": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": false
}
