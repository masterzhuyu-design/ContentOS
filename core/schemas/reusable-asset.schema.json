{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "contentos-lite/reusable-asset.schema.json",
  "title": "Reusable Asset",
  "type": "object",
  "required": ["schema", "asset_id", "asset_type", "title", "summary", "mechanism", "boundaries", "source_pointers", "body_pointer"],
  "properties": {
    "schema": {"const": "contentos-lite-reusable-asset-v1"},
    "asset_id": {"type": "string", "minLength": 1},
    "asset_type": {"enum": ["concept", "model", "case", "structure", "technique", "source"]},
    "title": {"type": "string", "minLength": 1},
    "summary": {"type": "string", "minLength": 1},
    "inputs": {"type": "array", "items": {"type": "string"}},
    "mechanism": {"type": "array", "items": {"type": "string"}},
    "outputs": {"type": "array", "items": {"type": "string"}},
    "boundaries": {"type": "array", "items": {"type": "string"}},
    "misuse_risks": {"type": "array", "items": {"type": "string"}},
    "tags": {"type": "array", "items": {"type": "string"}},
    "relations": {"type": "array", "items": {"type": "object"}},
    "source_pointers": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "rights_state": {"type": "string"},
    "maturity": {"enum": ["candidate", "working", "validated", "contested", "retired"]},
    "body_pointer": {"type": "string", "minLength": 1},
    "last_verified_at": {"type": ["string", "null"]}
  },
  "additionalProperties": false
}
