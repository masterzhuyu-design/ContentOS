{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "contentos/ontology-statement.schema.json",
  "title": "Ontology Statement",
  "type": "object",
  "required": ["schema", "statement_id", "subject", "predicate", "object", "source_pointer", "confidence_state", "status"],
  "properties": {
    "schema": {"const": "contentos-ontology-statement-v1"},
    "statement_id": {"type": "string", "minLength": 1},
    "subject": {"type": "string", "minLength": 1},
    "predicate": {"enum": ["is_a", "part_of", "causes", "enables", "constrains", "conflicts_with", "variant_of", "evidenced_by", "applies_to", "custom"]},
    "custom_predicate": {"type": ["string", "null"]},
    "object": {"type": "string", "minLength": 1},
    "qualifiers": {"type": "object"},
    "source_pointer": {"type": "string", "minLength": 1},
    "confidence_state": {"enum": ["confirmed", "best_current_judgment", "inference", "unknown", "contested"]},
    "counterevidence": {"type": "array", "items": {"type": "string"}},
    "status": {"enum": ["active", "contested", "superseded", "retired"]},
    "updated_at": {"type": "string"}
  },
  "additionalProperties": false
}
